# StrayBuddy local setup — CSV storage (no database server needed)

# Both frontends share this one backend:
BACKEND_API_URL=http://127.0.0.1:5000
BACKEND_PORT=5000
USER_PORT=3000
ADMIN_PORT=3001

# Data lives in backend/data/*.csv and uploads in public/uploads/.
# MySQL is no longer used, so there are no DB_* settings to fill in.

# Secret used to sign the admin console token.
# Change it and every admin is signed out; keep it private.
ADMIN_TOKEN_SECRET=straybuddy-admin-dev-secret
